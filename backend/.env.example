DATABASE_URL=jdbc:postgresql://localhost:5432/quantedge
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

UPSTASH_REDIS_REST_URL=http://localhost:8081
UPSTASH_REDIS_REST_TOKEN=test-token

# Google Cloud Console -> OAuth consent screen + credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secrets (generate with `openssl rand -base64 64`)
JWT_ACCESS_SECRET=your-256-bit-secret-for-access-token
JWT_REFRESH_SECRET=your-256-bit-secret-for-refresh-token

FRONTEND_URL=http://localhost:3000

# Set to false only for local HTTP development; must be true (default) wherever served over HTTPS
COOKIE_SECURE=true

# External market data APIs (Phase 2)
# Finnhub: https://finnhub.io (free tier, 60 req/min) - profiles + real-time quotes
FINNHUB_API_KEY=your-finnhub-api-key
# Twelve Data: https://twelvedata.com (free tier, 800 req/day) - OHLCV/chart data
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Kafka (Aiven, SASL_SSL) - Phase 3
KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_TRUSTSTORE_LOCATION=classpath:aiven-ca.pem
