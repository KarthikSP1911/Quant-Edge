DATABASE_URL=jdbc:postgresql://localhost:5432/quantedge
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

UPSTASH_REDIS_REST_URL=http://localhost:8081
UPSTASH_REDIS_REST_TOKEN=test-token

# Google Cloud Console -> OAuth consent screen + credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secrets (generate with `openssl rand -base64 64`)
JWT_ACCESS_SECRET=your-256-bit-secret-for-access-token
JWT_REFRESH_SECRET=your-256-bit-secret-for-refresh-token

FRONTEND_URL=http://localhost:3000
