type Company {
    id: ID!
    symbol: String!
    name: String!
    sector: String!
    industry: String!
    description: String
    logoUrl: String
    exchange: String!
}

type Quote {
    currentPrice: Float!
    high: Float!
    low: Float!
    open: Float!
    previousClose: Float!
    timestamp: Int!
}

type Candle {
    datetime: String!
    open: Float!
    high: Float!
    low: Float!
    close: Float!
    volume: Float!
}

type StockDetail {
    company: Company!
    quote: Quote!
    candles: [Candle!]!
}

type WatchlistItem {
    company: Company!
    addedAt: String!
}

enum OrderSide {
    BUY
    SELL
}

enum OrderStatus {
    PENDING
    OPEN
    FILLED
    PARTIALLY_FILLED
    CANCELLED
    REJECTED
    EXPIRED
}

enum OrderType {
    MARKET
    LIMIT
    STOP_LOSS
    STOP_LIMIT
}

type Order {
    id: ID!
    symbol: String!
    side: OrderSide!
    type: OrderType!
    status: OrderStatus!
    quantity: Int!
    filledQuantity: Int!
    limitPrice: Float
    stopPrice: Float
    createdAt: String!
    updatedAt: String!
    expiresAt: String
}

type PortfolioPosition {
    company: Company!
    quantity: Int!
    averageCost: Float!
    currentPrice: Float!
    previousClose: Float!
    changePercent: Float!
    marketValue: Float!
    gainLoss: Float!
    gainLossPercent: Float!
}

type PortfolioSummary {
    cashBalance: Float!
    positions: [PortfolioPosition!]!
    totalMarketValue: Float!
    totalAccountValue: Float!
}

type Transaction {
    id: ID!
    symbol: String!
    side: OrderSide!
    quantity: Int!
    price: Float!
    executedAt: String!
}

type Dashboard {
    portfolio: PortfolioSummary!
    watchlistPreview: [WatchlistItem!]!
    recentTransactions: [Transaction!]!
}

type TimeMachineHolding {
    company: Company!
    quantity: Int!
    averageCost: Float!
    priceAtDate: Float!
    marketValue: Float!
    gainLoss: Float!
    gainLossPercent: Float!
}

type TimeMachineDecision {
    symbol: String!
    quantity: Int!
    buyPrice: Float!
    sellPrice: Float!
    executedAt: String!
    realizedGainPercent: Float!
}

type TimeMachineResult {
    asOfDate: String!
    cashBalance: Float!
    holdings: [TimeMachineHolding!]!
    totalMarketValue: Float!
    totalAccountValue: Float!
    bestDecisions: [TimeMachineDecision!]!
    worstDecisions: [TimeMachineDecision!]!
}

type ChatHistory {
    id: ID!
    role: String!
    content: String
    toolCalls: String
    createdAt: String!
}

type Query {
    companies: [Company!]!
    company(symbol: String!): Company
    stockDetail(symbol: String!, interval: String = "1day", outputSize: Int = 30): StockDetail
    watchlist: [WatchlistItem!]!
    dashboard: Dashboard!
    portfolio: PortfolioSummary!
    openOrders: [Order!]!
    filledOrders: [Order!]!
    orderHistory: [Order!]!
    portfolioTimeMachine(asOfDate: String!): TimeMachineResult!
    chatHistory: [ChatHistory!]!
}
