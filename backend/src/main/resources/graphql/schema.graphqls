type Company {
    id: ID!
    symbol: String!
    name: String!
    sector: String!
    industry: String!
    description: String
    logoUrl: String
    exchange: String!
}

type Quote {
    currentPrice: Float!
    high: Float!
    low: Float!
    open: Float!
    previousClose: Float!
    timestamp: Int!
}

type Candle {
    datetime: String!
    open: Float!
    high: Float!
    low: Float!
    close: Float!
    volume: Float!
}

type StockDetail {
    company: Company!
    quote: Quote!
    candles: [Candle!]!
}

type WatchlistItem {
    company: Company!
    addedAt: String!
}

enum OrderSide {
    BUY
    SELL
}

enum OrderStatus {
    PENDING
    OPEN
    FILLED
    PARTIALLY_FILLED
    CANCELLED
    REJECTED
    EXPIRED
}

enum OrderType {
    MARKET
    LIMIT
    STOP_LOSS
    STOP_LIMIT
}

type Order {
    id: ID!
    symbol: String!
    side: OrderSide!
    type: OrderType!
    status: OrderStatus!
    quantity: Int!
    filledQuantity: Int!
    limitPrice: Float
    stopPrice: Float
    createdAt: String!
    updatedAt: String!
    expiresAt: String
}

type PortfolioPosition {
    company: Company!
    quantity: Int!
    averageCost: Float!
    currentPrice: Float!
    previousClose: Float!
    changePercent: Float!
    marketValue: Float!
    gainLoss: Float!
    gainLossPercent: Float!
}

type PortfolioSummary {
    cashBalance: Float!
    positions: [PortfolioPosition!]!
    totalMarketValue: Float!
    totalAccountValue: Float!
}

type Transaction {
    id: ID!
    symbol: String!
    side: OrderSide!
    quantity: Int!
    price: Float!
    executedAt: String!
}

type Dashboard {
    portfolio: PortfolioSummary!
    watchlistPreview: [WatchlistItem!]!
    recentTransactions: [Transaction!]!
}

# --- Stock Comparison (Phase 4) ---

"""
Fundamentals for one comparison column. All nullable: the table renders the same rows for every
stock, so a metric the provider has no data for is null (rendered as an em dash), not zero.
"""
type Fundamentals {
    marketCap: Float
    peRatio: Float
    fiftyTwoWeekHigh: Float
    fiftyTwoWeekLow: Float
}

"""
One column of a comparison. `candles` shares an identical datetime axis with every other entry in
the same StockComparison, so the overlay chart can plot them together without re-aligning.
"""
type ComparisonEntry {
    company: Company!
    quote: Quote!
    fundamentals: Fundamentals!
    candles: [Candle!]!
}

type StockComparison {
    entries: [ComparisonEntry!]!
}

type Query {
    companies: [Company!]!
    company(symbol: String!): Company
    stockDetail(symbol: String!, interval: String = "1day", outputSize: Int = 30): StockDetail
    watchlist: [WatchlistItem!]!
    dashboard: Dashboard!
    portfolio: PortfolioSummary!
    openOrders: [Order!]!
    filledOrders: [Order!]!
    orderHistory: [Order!]!
    stockComparison(symbols: [String!]!, interval: String = "1day", outputSize: Int = 90): StockComparison!
}
