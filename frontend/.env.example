NEXT_PUBLIC_API_URL=http://localhost:8080

# Razorpay public Key ID (Test Mode) - safe to expose client-side, used by Checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Deployed split-domain setup (see docs/deploy.md): leave NEXT_PUBLIC_API_URL empty so the browser calls
# relative URLs, and set BACKEND_URL so Next.js proxies /api, /graphql and OAuth2 to it. Both are
# read at build time.
BACKEND_URL=
# Direct backend URL for SSE and Google OAuth2; falls back to NEXT_PUBLIC_API_URL when unset.
NEXT_PUBLIC_DIRECT_BACKEND_URL=
