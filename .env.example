# PostgreSQL (Neon in hosted mode; leave unset to use docker-compose's `local` profile defaults)
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require&channel_binding=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis (Upstash REST API in hosted mode; leave unset to use docker-compose's `local` profile
# redis-http sidecar, which speaks the same REST protocol against a plain local Redis container)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# External market data APIs (Phase 2)
# Finnhub: https://finnhub.io (free tier, 60 req/min) - profiles + real-time quotes
FINNHUB_API_KEY=
# Twelve Data: https://twelvedata.com (free tier, 800 req/day) - OHLCV/chart data
TWELVE_DATA_API_KEY=
# Alpha Vantage: https://www.alphavantage.co (free tier, 25 req/day) - technical indicators (SMA, RSI)
ALPHA_VANTAGE_API_KEY=

# Kafka - Phase 3. Leave all of these unset to use docker-compose's `local` profile Kafka
# container (PLAINTEXT). For hosted Aiven Kafka, set all of the below:
KAFKA_BOOTSTRAP_SERVERS=<host>:<port>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_BUNDLE=aiven-kafka
KAFKA_SSL_TRUSTSTORE_LOCATION=classpath:aiven-ca.pem

# Groq (Spring AI, OpenAI-compatible) - Phase 5
GROQ_API_KEY=

# Qdrant Cloud (vector store, RAG knowledge base) - Phase 5
QDRANT_API_KEY=
QDRANT_URL=

# Razorpay (wallet top-up, Test Mode - real money is never charged). Get test keys from the
# Razorpay Dashboard (Test Mode toggle) -> Settings -> API Keys. RAZORPAY_WEBHOOK_SECRET comes
# from Settings -> Webhooks after creating one pointed at /api/webhooks/razorpay (payment.captured)
# - for local dev, tunnel with ngrok or similar; the verify-payment flow works without it too.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
